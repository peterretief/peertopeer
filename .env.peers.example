# Reachable HTTPS control URL; localhost would refer to each container.
HEADSCALE_URL=https://headscale.example.com
# Needed only for first enrollment. Use a short-lived reusable NON-ephemeral
# Headscale key; clear it after both peers have registered.
HEADSCALE_AUTHKEY=
# Use a distinct prefix on every host (dstore-local, dstore-headscale, etc.).
PEER_PREFIX=dstore-local
# Include the desktop's mesh identity and every participating storage peer.
DSTORE_MEMBERS=dstore-local-a,dstore-local-b,dstore-local-c,dstore-local-d,YOUR-DESKTOP-MESH-NAME
DSTORE_SHARE_ID=personal
# Defaults for the initial persisted node.json: 1 GiB storage, 64 MiB input.
DSTORE_QUOTA_BYTES=1073741824
DSTORE_MAX_FILE_BYTES=67108864
# Optional: pin to an approved Tailscale image version or digest.
# TAILSCALE_IMAGE=tailscale/tailscale:stable
